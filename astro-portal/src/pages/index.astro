---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SentinelX SOC | Astro High-Performance Threat Intelligence Portal">
  <main class="container" style="padding-top: 60px; padding-bottom: 80px;">
    <!-- Astro Hero Header -->
    <header style="text-align: center; margin-bottom: 50px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); padding: 6px 14px; border-radius: 9999px; font-size: 12px; font-weight: 700; color: #38bdf8; margin-bottom: 16px;">
        <span>🚀 POWERED BY ASTRO &amp; PYTHON SIEM ENGINE</span>
      </div>
      <h1 style="font-size: 48px; font-weight: 800; color: #fff; letter-spacing: -1px; margin-bottom: 12px;">
        Sentinel<span style="color: #38bdf8;">X</span> Threat Operations
      </h1>
      <p style="font-size: 18px; color: #94a3b8; max-width: 750px; margin: 0 auto 24px auto;">
        High-Performance Enterprise SOC Portal combining Wazuh, Zeek, MISP, Sysmon, and Python Automation with RFC 6238 2FA.
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="http://127.0.0.1:5000" style="background: linear-gradient(135deg, #0284c7, #8b5cf6); color: #fff; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 14px; box-shadow: 0 0 20px rgba(56, 189, 248, 0.4);">
          🛡️ Launch Live SIEM Platform &rarr;
        </a>
        <a href="#validation" style="background: #1e293b; color: #fff; border: 1px solid #334155; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px;">
          View Validated Detection Flow
        </a>
      </div>
    </header>

    <!-- Key Metrics in Astro -->
    <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 48px;">
      <div style="background: #0f172a; border: 1px solid #1e2e4a; border-radius: 12px; padding: 20px; text-align: center;">
        <div style="font-size: 32px; font-weight: 800; color: #38bdf8;">&lt; 40ms</div>
        <div style="font-size: 12px; color: #94a3b8; text-transform: uppercase; margin-top: 4px;">MISP Enrichment Speed</div>
      </div>
      <div style="background: #0f172a; border: 1px solid #1e2e4a; border-radius: 12px; padding: 20px; text-align: center;">
        <div style="font-size: 32px; font-weight: 800; color: #10b981;">70%</div>
        <div style="font-size: 12px; color: #94a3b8; text-transform: uppercase; margin-top: 4px;">MTTR Reduction</div>
      </div>
      <div style="background: #0f172a; border: 1px solid #1e2e4a; border-radius: 12px; padding: 20px; text-align: center;">
        <div style="font-size: 32px; font-weight: 800; color: #8b5cf6;">100%</div>
        <div style="font-size: 12px; color: #94a3b8; text-transform: uppercase; margin-top: 4px;">Zero-Trust 2FA Protected</div>
      </div>
      <div style="background: #0f172a; border: 1px solid #1e2e4a; border-radius: 12px; padding: 20px; text-align: center;">
        <div style="font-size: 32px; font-weight: 800; color: #f59e0b;">18+</div>
        <div style="font-size: 12px; color: #94a3b8; text-transform: uppercase; margin-top: 4px;">MITRE ATT&amp;CK Mapped</div>
      </div>
    </section>

    <!-- Lab Telemetry Path -->
    <section id="validation" style="background: #0f172a; border: 1px solid #1e2e4a; border-radius: 16px; padding: 36px; margin-bottom: 48px;">
      <h2 style="font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 8px;">
        ✅ Positive IOC Validation Architecture (192.0.2.123)
      </h2>
      <p style="font-size: 14px; color: #94a3b8; margin-bottom: 24px;">
        Controlled validation performed in physical home lab. Windows 11 endpoint generated HTTP request with Host <code style="color: #38bdf8;">192.0.2.123</code>. Zeek captured transaction and SentinelX automatically matched MISP Event ID 1.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px;">
        <div style="background: #111a2d; border: 1px solid #263654; border-radius: 10px; padding: 16px;">
          <strong style="color: #fff; font-size: 14px;">1. Controlled IOC</strong>
          <p style="font-size: 12px; color: #38bdf8; margin-top: 4px; font-family: monospace;">192.0.2.123</p>
        </div>
        <div style="background: #111a2d; border: 1px solid #263654; border-radius: 10px; padding: 16px;">
          <strong style="color: #fff; font-size: 14px;">2. Zeek Sensor</strong>
          <p style="font-size: 12px; color: #94a3b8; margin-top: 4px;">Parsed into http.log</p>
        </div>
        <div style="background: #111a2d; border: 1px solid #263654; border-radius: 10px; padding: 16px;">
          <strong style="color: #fff; font-size: 14px;">3. Python Engine</strong>
          <p style="font-size: 12px; color: #94a3b8; margin-top: 4px;">Extracted IOC &amp; queried MISP</p>
        </div>
        <div style="background: #111a2d; border: 1px solid #10b981; border-radius: 10px; padding: 16px;">
          <strong style="color: #10b981; font-size: 14px;">4. MISP Positive Match</strong>
          <p style="font-size: 12px; color: #10b981; margin-top: 4px;">Event ID 1 · Network Activity</p>
        </div>
      </div>
    </section>

    <!-- Recruiter & Hiring Section -->
    <section style="background: linear-gradient(135deg, rgba(6,182,212,0.1), rgba(139,92,246,0.1)); border: 1px solid rgba(56,189,248,0.3); border-radius: 16px; padding: 40px; text-align: center;">
      <h2 style="font-size: 24px; font-weight: 800; color: #fff; margin-bottom: 8px;">
        Designed &amp; Engineered by Mukesh Jena (MCA)
      </h2>
      <p style="font-size: 14px; color: #cbd5e1; max-width: 600px; margin: 0 auto 24px auto;">
        Actively interviewing for Security Operations Center (SOC) Analyst, Threat Intelligence, and Detection Engineering positions.
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="https://github.com/mukesh-soc/Deep-Soc-Lab" target="_blank" style="background: #1e293b; color: #fff; border: 1px solid #334155; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 600;">
          GitHub: mukesh-soc/Deep-Soc-Lab
        </a>
        <a href="mailto:mukesh.soc.analyst@gmail.com" style="background: #0284c7; color: #fff; padding: 10px 24px; border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 700;">
          Contact Mukesh
        </a>
      </div>
    </section>
  </main>
</Layout>
